{
  "compilerOptions": {
    /* Configuración del Entorno y Destino */
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],

    /* Configuración del Entorno de Node (Vite Config) */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Optimización de Compilación y Caché */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,

    /* Reglas de Calidad de Código (Linting) */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
